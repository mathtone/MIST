<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Mathtone.MIST</AssemblyName>
    <RootNamespace>Mathtone.MIST</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Mathtone.MIST</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <Title>MIST - Property Change Notification IL Weaver</Title>
    <Description>Automatically implements INotifyPropertyChanged for properties using IL weaving and MSBuild tasks.</Description>
    <Authors>Mathtone Industries</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mathtone/MIST</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mathtone/MIST</RepositoryUrl>
    <PackageTags>INotifyPropertyChanged;IL;Weaving;MVVM;WPF;PropertyChanged</PackageTags>
  </PropertyGroup>

</Project>